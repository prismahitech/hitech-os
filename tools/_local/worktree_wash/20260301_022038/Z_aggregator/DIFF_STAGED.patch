-export type DemoRole = (typeof DEMO_ROLES)[number];
-export type DemoSupplierStatus = (typeof DEMO_SUPPLIER_STATUSES)[number];
-export type DemoDocumentLifecycle = (typeof DEMO_DOCUMENT_LIFECYCLES)[number];
