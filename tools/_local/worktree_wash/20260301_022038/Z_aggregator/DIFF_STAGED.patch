-
-export type Role = "admin" | "operator" | "auditor";
-export type SupplierStatus = "APPROVED" | "BLOCKED";
-export type DocStatus = "PRESENT" | "MISSING" | "EXPIRED";
-export type ShipmentState = "ARRIVED" | "DOCS_HOLD" | "RECEIVED" | "QUARANTINE";
