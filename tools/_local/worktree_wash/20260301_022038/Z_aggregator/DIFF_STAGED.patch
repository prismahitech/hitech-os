-import { PITCH_SCREEN_FIXTURES, type PitchScreen05, type PitchScreen06 } from "@hitech/contracts";
-
-type PitchStatus =
-  PitchScreen05["foundationStatus"]["rbacMatrixSnapshot"]["rows"][number]["status"];
