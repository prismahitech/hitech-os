-
-  if (state.role !== "auditor") {
-    actions.push("TOGGLE_DOCS_COMPLETE", "TOGGLE_TEMP_EXCURSION");
-  }
-
-  for (const candidate of DEMO_SHIPMENT_STATES) {
-    if (canAdvanceTo(state, candidate).allowed) {
-      actions.push(`SHIPMENT_ADVANCE:${candidate}`);
-    }
-  }
-
-  return actions;
