{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"prisma.visual.canonical-promotion-request.v1",
  "type":"object","additionalProperties":false,
  "required":["schema","requestId","target","expectedCurrentHead","currentTruth","source","decision","authorization"],
  "properties":{
    "schema":{"const":"prisma.visual.canonical-promotion-request.v1"},
    "requestId":{"type":"string","pattern":"^cpr-[a-z0-9][a-z0-9._-]{0,95}$"},
    "target":{
      "type":"object","additionalProperties":false,"required":["targetId","censusTargetId","surfaceKey"],
      "properties":{
        "targetId":{"type":"string","pattern":"^TGT\.[A-Za-z0-9._-]+$"},
        "censusTargetId":{"type":"string","pattern":"^TGT\.CENSUS\.[A-Za-z0-9._-]+$"},
        "surfaceKey":{"enum":["tablet","pc","mobile","shared-ui"]}
      }
    },
    "expectedCurrentHead":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "currentTruth":{"$ref":"current-truth-snapshot.schema.json"},
    "source":{"type":"object","additionalProperties":false,"required":["digest","path"],"properties":{"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"path":{"type":"string","minLength":1},"candidateRef":{"type":"string"}}},
    "decision":{
      "type":"object","additionalProperties":false,
      "required":["semanticAction","semanticAuthority","targetAction","recipeAction","bindingAction","layerAction"],
      "properties":{
        "semanticAction":{"enum":["REUSE_EXISTING","CREATE_NEW"]},
        "semanticDecisionId":{"type":"string"},"approvalEvidenceRefs":{"type":"array","items":{"type":"string"}},
        "semanticAuthority":{"type":"object","additionalProperties":false,"required":["authorityDomain","writerKind","canonicalMeaningId","decisionRef"],"properties":{"authorityDomain":{"const":"ndc"},"writerKind":{"const":"NDC_CURATION"},"canonicalMeaningId":{"type":"string"},"decisionRef":{"type":"string"}}},
        "targetAction":{"type":"object","additionalProperties":false,"required":["action"],"properties":{"action":{"enum":["CREATE_NEW","REUSE_EXISTING"]},"existingCanonicalTargetIds":{"type":"array","items":{"type":"string"}}}},
        "recipeAction":{"type":"object","properties":{"action":{"enum":["CREATE_NEW","REUSE_EXISTING"]},"recipeId":{"type":"string"},"semanticKey":{"type":"string"},"registryEntry":{"type":"object"}}},
        "bindingAction":{"type":"object","properties":{"action":{"enum":["CREATE_NEW","REUSE_EXISTING"]},"bindingId":{"type":"string"},"semanticKey":{"type":"string"},"exactBinding":{"type":"object"},"registryEntry":{"type":"object"}}},
        "layerAction":{"type":"object","additionalProperties":false,"required":["applicationLayerId","policy","writerKind","authorityDomain","decisionRef"],"properties":{"applicationLayerId":{"type":"string","pattern":"^LYR\\."},"policy":{"enum":["EXACT_TARGET_ONLY","BOUNDED_EXACT_TARGET_WAVE"]},"writerKind":{"const":"CANONICAL_REGISTRATION"},"authorityDomain":{"const":"rifat"},"decisionRef":{"type":"string","minLength":1}}},
        "projectionAction":{"type":"object"},"idInputs":{"type":"object"}
      }
    },
    "authorization":{"type":"object","additionalProperties":false,"required":["canonicalRegistrationAuthorized","automaticSemanticInference","automaticApplicationSource"],"properties":{"canonicalRegistrationAuthorized":{"const":true},"automaticSemanticInference":{"const":false},"automaticApplicationSource":{"const":false}}}
  }
}