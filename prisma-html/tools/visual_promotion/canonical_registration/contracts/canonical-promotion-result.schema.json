{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"prisma.visual.canonical-promotion-result.v1",
  "type":"object","additionalProperties":false,
  "required":["schema","capabilityId","requestId","targetId","status","ids","evidenceDigest"],
  "properties":{
    "schema":{"const":"prisma.visual.canonical-promotion-result.v1"},
    "capabilityId":{"const":"visual.canonical_promotion_integration_v1"},
    "requestId":{"type":"string"},"targetId":{"type":"string"},
    "status":{"enum":["APPLIED","NO_OP_IDEMPOTENT","BLOCKED","COLLISION","STALE","FAILED","ROLLED_BACK"]},
    "ids":{"type":"object"},"evidenceDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
