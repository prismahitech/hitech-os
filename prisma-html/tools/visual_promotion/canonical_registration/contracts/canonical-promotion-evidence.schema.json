{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"prisma.visual.canonical-promotion-evidence.v1",
  "type":"object","additionalProperties":false,
  "required":["schema","requestId","requestDigest","currentTruthDigest","sourceDigest","preState","postState","ids","mutations","status","errors"],
  "properties":{
    "schema":{"const":"prisma.visual.canonical-promotion-evidence.v1"},
