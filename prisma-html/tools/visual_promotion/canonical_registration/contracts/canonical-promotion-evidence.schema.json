    "currentTruthDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"sourceDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "preState":{"type":"array","items":{"type":"object"}},"postState":{"type":"array","items":{"type":"object"}},
    "preStateValues":{"type":"object"},"ids":{"type":"object"},"mutations":{"type":"array"},
    "journalPath":{"type":"string"},"postconditions":{"type":"object"},
