    "identityDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "rifatDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "ndcDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "projectionDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "authorityMeshDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "layerMapDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "targetEvidenceDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
