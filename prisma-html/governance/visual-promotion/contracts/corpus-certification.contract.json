{
  "schema": "prisma.visual-promotion.corpus-certification.contract.v1",
  "version": "1.1.0",
  "phase": "CANDIDATE_CORPUS_FINAL_AGGREGATION",
  "candidateOnly": true,
  "expectedCorpusCount": 2097,
  "acceptedCertificationRegistry": "prisma-html/governance/visual-promotion/contracts/certification-intake.registry.json",
  "exactCertificationHandoffsRequired": true,
  "certificationLabels": [
