      "purpose": "Contact, quote and conversion forms.",
      "allowedSurfaces": ["web", "landing"],
      "controlledVariables": ["fields", "labels", "validation", "cta", "success-state"]
    },
    {
      "id": "MASTER.CTA.V1",
      "name": "CTA",
      "type": "projection",
      "status": "CANONICAL_MAPPING",
      "canonical": {
        "familyId": "FAM.BUTTON.PRIMARY.SOLID",
        "presetId": "PRESET.BUTTON.PRIMARY.SOLID.V2",
        "recipeId": "REC.button.governed.v2"
      },
      "purpose": "Primary conversion action.",
      "allowedSurfaces": ["web", "landing", "social", "presentation", "one-pager", "video"],
      "controlledVariables": ["copy", "destination", "state"]
    },
    {
      "id": "MASTER.PROCESS.V1",
      "name": "Process / How It Works",
      "type": "composition",
      "status": "GOVERNED_COMPOSITION",
      "canonicalBases": ["card", "panel", "typography", "indicator", "state", "button"],
      "htmlPatterns": [".prisma-operational-flow", "gramatica-operativa"],
      "purpose": "Explain an operational or product flow.",
      "allowedSurfaces": ["web", "landing", "carousel", "presentation", "one-pager"],
      "doNotCreate": ["FAM.FLOW", "REC.flow"]
    },
    {
      "id": "MASTER.PROBLEM-SOLUTION.V1",
      "name": "Problem / Solution",
      "type": "composition",
      "status": "GOVERNED_COMPOSITION",
      "canonicalBases": ["panel", "card", "typography", "metric", "button"],
      "htmlPatterns": [".prisma-definition", ".prisma-outcomes", ".difference-map"],
      "purpose": "Frame a business problem and its governed solution.",
      "allowedSurfaces": ["web", "landing", "social", "carousel", "presentation", "one-pager"]
    },
    {
      "id": "MASTER.CAMPAIGN.V1",
      "name": "Campaign / Narrative",
      "type": "composition",
      "status": "GOVERNED_COMPOSITION",
      "canonicalBases": ["navigation", "hero", "headline", "panel", "card", "metric", "process", "proof", "cta"],
      "htmlPatterns": ["narrative-page"],
      "purpose": "Long-form campaign or case-study narrative.",
      "allowedSurfaces": ["web", "landing", "presentation", "one-pager", "social"]
    },
    {
      "id": "MASTER.CORPORATE-DECK.V1",
      "name": "Corporate / Investor Deck",
      "type": "composition",
      "status": "GOVERNED_COMPOSITION",
      "canonicalBases": ["navigation", "hero", "headline", "metric", "card", "panel", "process", "proof", "cta"],
      "htmlPatterns": ["investor-deck"],
      "purpose": "Corporate presentation and investor-facing narrative.",
      "allowedSurfaces": ["presentation", "pdf", "web"],
      "doNotCreate": ["REC.investor", "FAM.INVESTOR"]
    }
  ],
  "surfaceAdapters": {
    "web": "ADP.WEB.RESPONSIVE.V2",
    "desktop-admin": "ADP.PC.ADMIN.V2",
    "tablet": "ADP.TB.TOUCH.V2",
    "mobile": "ADP.MB.TOUCH.V2",
    "shared-neutral": "ADP.SHARED.NEUTRAL.V2"
  },
  "states": {
    "registry": "STATESET.INTERACTIVE.COMPLETE.V1",
    "requiredPrinciples": ["focus-visible", "reduced-motion"],
    "marketingMustPreserve": ["default", "hover", "focus-visible", "pressed", "disabled", "loading", "success", "warning", "error"]
  },
  "verticalProjection": {
    "controlledVariablesOnly": [
      "scene",
      "business-problem",
      "kpis",
      "ui-modules",
      "copy",
      "cta",
      "imagery"
    ],
    "mustNotChange": [
      "visual-identity",
      "canonical-family-semantics",
      "canonical-recipe-semantics",
      "governed-state-model",
      "accessibility-floor"
    ]
  },
  "assetFamilies": {
    "osVertical": [
      "hero",
      "dashboard-hero",
      "problem",
      "solution",
      "educational-carousel",
      "one-pager",
      "short-video",
      "story-status"
    ],
    "changeAssurance": [
      "hero",
      "problem-ungoverned-changes",
      "six-stage-map",
      "evidence-chain",
      "pass-blocked-unknown",
      "change-studio",
      "authority-pack",
      "verify",
      "evidence-report",
      "thought-leadership-carousel",
      "demo-video",
      "enterprise-one-pager"
    ]
  },
  "governance": {
    "atlasfinRole": "visual-control-cockpit",
    "atlasfinIsNot": [
      "marketing-authority",
      "route-owner-authority",
      "replacement-for-rifat-identity",
      "replacement-for-prisma-ui"
    ],
    "identityProfile": "prisma.clear-operational.v1",
    "marketingRule": "Clone the master; change controlled variables; preserve authority.",
    "evidenceRule": "Product UI is evidence of the message, not decoration.",
    "claimRule": "Do not claim capabilities, certifications or readiness without separate evidence."
  }
}
