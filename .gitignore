tools/ui_map/_logs/[0-9]*/

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Dangerous artifacts and dumps
**/src/**/*.zip
**/src/**/*.7z
**/src/**/*.rar
**/src/**/*.tar
**/src/**/*.gz
**/src/**/*.sql
**/src/**/*.sqlite
