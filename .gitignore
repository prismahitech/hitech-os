/FINAL_REPORT*.txt
/FINAL_REPORT*.md
/DISPATCH_*DIFF*.txt
/factory_*.log
/FILES_CREATED*.txt
/FILES_MODIFIED*.txt
/PROMPTS_PACK_*.txt
/STATUS.json
*.bak
# --- /HITECH ROOT CLUTTER (auto) ---
tools/_local/context_exporter/export_repo_context.py

