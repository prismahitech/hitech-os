**/src/**/*.png
**/src/**/*.jpg
**/src/**/*.jpeg
**/src/**/*.bmp

# Allow deterministic generated schemas only
!packages/contracts/schemas/generated/*.json

# --- Codex/Factory run artifacts (DO NOT TRACK) ---
