!tools/codex/dispatch/
tools/codex/dispatch/*
!tools/codex/dispatch/execution_rules.json
!tools/codex/dispatch/post_run_intelligence.py
tools/codex/verify/
.husky/_/
factory/01 Mirror/

# --- HITECH ROOT CLUTTER (auto) ---
