{
  "version": "v1",
  "description": "Golden UX sessions for pyside6_glass workbench semantic release proof.",
  "sessions": [
    {
      "session_id": "startup_blank_workspace",
      "purpose": "Ensure startup opens into a clean actionable workspace-first state.",
      "sacred_capabilities": [8, 10, 12, 33, 34, 40],
      "setup": {
        "entrypoint": "workbench_window",
        "mode": "headless"
      },
      "steps": [
        {"action": "show"},
        {"action": "checkpoint", "id": "startup.blank"}
      ],
      "checkpoints": ["startup.blank"],
      "success_criteria": [
        "blank workspace is visible",
        "at least one actionable add/browse path is visible",
        "no hard crash during startup"
      ],
      "failure_severity": "blocker"
    },
    {
      "session_id": "picker_search_and_category",
      "purpose": "Validate picker discoverability, search filtering, and category filtering.",
      "sacred_capabilities": [21, 22, 24, 25, 31, 33],
      "setup": {
        "entrypoint": "workbench_window",
        "mode": "headless"
      },
      "steps": [
        {"action": "open_picker"},
        {"action": "picker_search", "text": "dashboard"},
        {"action": "picker_set_category", "value": "Data Dashboards"},
        {"action": "checkpoint", "id": "picker.filtered"},
        {"action": "close_picker"}
      ],
      "checkpoints": ["picker.filtered"],
      "success_criteria": [
        "picker opens from command flow",
        "search and category filters reduce list context",
        "selection state is actionable"
      ],
      "failure_severity": "major"
    },
    {
      "session_id": "add_to_current_tab",
      "purpose": "Add selected content into active tab with explicit result.",
      "sacred_capabilities": [3, 10, 33, 34, 40],
      "setup": {
        "entrypoint": "workbench_window",
        "mode": "headless"
      },
      "steps": [
        {"action": "open_empty_tab"},
        {"action": "open_picker"},
        {"action": "picker_search", "text": "form"},
        {"action": "picker_select_first"},
        {"action": "picker_add_current"},
        {"action": "checkpoint", "id": "tab.current.added"}
      ],
      "checkpoints": ["tab.current.added"],
      "success_criteria": [
        "current tab remains active",
        "active workspace host is mounted",
        "selected content appears in active tab context"
      ],
      "failure_severity": "blocker"
    },
    {
      "session_id": "open_in_new_tab",
      "purpose": "Open selected content in a new tab with lazy tab policy preserved.",
      "sacred_capabilities": [30, 31, 32, 57, 60, 80],
      "setup": {
        "entrypoint": "workbench_window",
        "mode": "headless"
      },
      "steps": [
        {"action": "open_picker"},
        {"action": "picker_search", "text": "dashboard"},
        {"action": "picker_select_first"},
        {"action": "picker_open_new_tab"},
        {"action": "checkpoint", "id": "tab.new.opened"}
      ],
      "checkpoints": ["tab.new.opened"],
      "success_criteria": [
        "tab count increases",
        "active tab reflects newly opened content",
        "non-active tabs remain lazy where expected"
      ],
      "failure_severity": "blocker"
    },
    {
      "session_id": "drag_panel_cross_slot",
      "purpose": "Validate direct manipulation for panel drag across slots with constraints.",
      "sacred_capabilities": [3, 5, 6, 71, 74, 79],
      "setup": {
        "entrypoint": "workbench_window",
        "mode": "headless"
      },
      "steps": [
        {"action": "prepare_editor_context"},
        {"action": "insert_chart_panel"},
        {"action": "drag_selected_panel_to_side"},
        {"action": "checkpoint", "id": "panel.drag.cross_slot"}
      ],
      "checkpoints": ["panel.drag.cross_slot"],
      "success_criteria": [
        "panel slot assignment changes from main to side",
        "movement remains clamped to workspace bounds",
        "session remains stable after drag"
      ],
      "failure_severity": "blocker"
    },
    {
      "session_id": "resize_panel_and_clamp",
      "purpose": "Validate direct panel resize and clamp limits.",
      "sacred_capabilities": [4, 5, 10, 41, 67, 76],
      "setup": {
        "entrypoint": "workbench_window",
        "mode": "headless"
      },
      "steps": [
        {"action": "prepare_editor_context"},
        {"action": "insert_chart_panel"},
        {"action": "resize_selected_panel", "delta_y": 120},
        {"action": "checkpoint", "id": "panel.resize.clamped"}
      ],
      "checkpoints": ["panel.resize.clamped"],
      "success_criteria": [
        "panel enters fixed height policy",
        "height stays within min/max constraints",
        "workspace geometry remains valid"
      ],
      "failure_severity": "blocker"
    },
    {
      "session_id": "clone_reset_isolation",
      "purpose": "Validate non-destructive clone/save/reset isolation flow.",
      "sacred_capabilities": [16, 22, 23, 24, 77, 99],
      "setup": {
        "entrypoint": "workbench_window",
        "mode": "headless"
      },
      "steps": [
        {"action": "prepare_editor_context"},
        {"action": "insert_chart_panel"},
        {"action": "save_clone", "name": "golden_clone_session"},
        {"action": "checkpoint", "id": "clone.saved"},
        {"action": "reset_editor"},
        {"action": "checkpoint", "id": "clone.reset"}
      ],
      "checkpoints": ["clone.saved", "clone.reset"],
      "success_criteria": [
        "session source switches to clone after save",
        "reset returns to baseline for active source",
        "unsaved changes are not silently persisted to pristine entry"
      ],
      "failure_severity": "blocker"
    },
    {
      "session_id": "data_runtime_probe_states",
      "purpose": "Validate provider query probe, stale visibility, and runtime diagnostics.",
      "sacred_capabilities": [13, 14, 15, 18, 19, 20, 21, 37],
      "setup": {
        "entrypoint": "workbench_window",
        "mode": "headless"
      },
      "steps": [
        {"action": "select_category", "value": "Data Dashboards"},
        {"action": "select_entry", "value": "data.live_metrics_board"},
        {"action": "probe_selected_query"},
        {"action": "refresh_runtime"},
        {"action": "checkpoint", "id": "data.runtime.probed"}
      ],
      "checkpoints": ["data.runtime.probed"],
      "success_criteria": [
        "probe payload contains provider/query/state/latency/freshness",
        "runtime payload includes integration boundaries and action trace",
        "data/runtime tabs remain reachable and coherent"
      ],
      "failure_severity": "blocker"
    }
  ]
}
