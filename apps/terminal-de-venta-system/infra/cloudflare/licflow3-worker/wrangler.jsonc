{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prisma-cloud-semilla",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-02",
  "workers_dev": false,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "PRISMA_LICFLOW3_D1",
      "database_name": "prisma_cloud_semilla",
      "database_id": "76b12f35-f123-4b94-914f-6dde22b7fdc9"
    }
  ],
  "vars": {
    "PRISMA_LICFLOW3_MODE": "worker-d1"
  }
}
