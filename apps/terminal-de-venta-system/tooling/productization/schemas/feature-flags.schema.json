{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prisma.local/schemas/feature-flags.schema.json",
  "title": "feature-flags",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "businessId",
    "source",
    "features",
    "updatedAt"
  ],
  "properties": {
    "businessId": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "dev",
        "license",
        "remote_ops",
        "local_override"
      ]
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "updatedAt": {
      "type": "string"
    }
  }
}
