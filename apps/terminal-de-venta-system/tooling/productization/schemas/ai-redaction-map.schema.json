{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Redaction Map",
  "type": "object",
  "required": [
    "rules"
  ],
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fieldPattern",
          "action"
        ],
        "properties": {
          "fieldPattern": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "drop",
              "hash",
              "mask",
              "truncate",
              "aggregate"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
