{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prisma.local/schemas/environment-policy.schema.json",
  "title": "environment-policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allowedVariables",
    "redactedVariables",
    "forbiddenInCommits",
    "precedence"
  ],
  "properties": {
    "allowedVariables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "redactedVariables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbiddenInCommits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "precedence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
