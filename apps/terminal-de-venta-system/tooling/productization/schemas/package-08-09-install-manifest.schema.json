{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Package 08/09 Install Manifest",
  "type": "object",
  "required": [
    "packageId",
    "files",
    "createdAt"
  ],
  "properties": {
    "packageId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    }
  }
}
