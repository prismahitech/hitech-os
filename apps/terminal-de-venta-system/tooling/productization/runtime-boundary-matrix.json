      "mode": "dev",
      "dbInsideRepoAllowed": true,
      "requiresLicense": false,
      "requiresInternet": false
    },
    {
      "mode": "standalone",
      "dbInsideRepoAllowed": false,
      "requiresLicense": true,
      "requiresInternet": false
    },
    {
      "mode": "pro",
      "dbInsideRepoAllowed": false,
      "requiresLicense": true,
      "requiresInternet": false
    },
    {
      "mode": "pc_backoffice",
      "dbInsideRepoAllowed": false,
      "requiresLicense": true,
      "requiresInternet": false
    },
    {
      "mode": "managed",
      "dbInsideRepoAllowed": false,
      "requiresLicense": true,
      "requiresInternet": "intermittent"
    },
    {
      "mode": "degraded_managed",
      "dbInsideRepoAllowed": false,
      "requiresLicense": true,
      "requiresInternet": false
    }
