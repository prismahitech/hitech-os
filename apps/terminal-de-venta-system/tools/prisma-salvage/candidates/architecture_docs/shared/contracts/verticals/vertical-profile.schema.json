    "displayName",
    "market",
    "status",
    "priority",
    "capabilities",
    "tabletNavigation",
    "pcNavigation",
    "tabletBlockedCapabilities",
    "events",
    "permissions",
    "offlinePolicy",
    "kpis",
    "acceptanceCriteria"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "capabilities": {
      "type": "array"
    },
    "tabletNavigation": {
      "type": "array"
    },
    "pcNavigation": {
      "type": "array"
    },
    "events": {
      "type": "array"
    }
  }
}
