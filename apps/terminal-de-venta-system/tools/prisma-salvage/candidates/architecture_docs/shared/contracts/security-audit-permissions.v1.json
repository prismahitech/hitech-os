        "permission": "receiving.write",
        "offlineAllowed": false,
        "auditRequired": true
      },
      "sync.ingest.persist": {
        "permission": "sync.ingest.write",
        "offlineAllowed": false,
        "auditRequired": true
      },
      "sync.conflict.resolve": {
        "permission": "sync.conflict.resolve",
