  "auditFields": [
    "actorId",
    "role",
    "terminalId",
    "businessId",
    "action",
    "permission",
    "entityType",
    "entityId",
    "before",
    "after",
    "createdAt"
  ],
  "offlineRestrictions": [
    "Tablet can complete local sales and local exports offline.",
    "Tablet offline writes must keep actorId and outbox events.",
    "PC governance writes require PC context and must not block basic Tablet sales.",
    "Conflict resolution must be traceable with actorId before changing conflict state."
  ]
