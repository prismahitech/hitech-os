        "permission": "inventory.local.adjust",
        "offlineAllowed": true,
        "auditRequired": true
      },
      "shift.close": {
        "permission": "shift.close",
        "offlineAllowed": true,
        "auditRequired": true
      }
    },
    "pc": {
      "catalog.write": {
        "permission": "catalog.write",
        "offlineAllowed": false,
        "auditRequired": true
      },
      "inventory.adjust.approve": {
        "permission": "inventory.adjust.approve",
        "offlineAllowed": false,
        "auditRequired": true
      },
      "purchase.write": {
        "permission": "purchase.write",
        "offlineAllowed": false,
        "auditRequired": true
      },
