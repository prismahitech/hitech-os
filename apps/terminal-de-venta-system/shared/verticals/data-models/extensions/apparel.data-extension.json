{
  "verticalId": "apparel",
  "label": "Ropa / boutique",
  "version": "0.3.0",
  "principle": "Variantes de talla/color y cambios; no meter talla y color como columnas eternas en Product.",
  "extensions": [
    {
      "extensionId": "apparel.VariantMatrix",
      "entityName": "VariantMatrix",
      "extensionType": "inventory_extension",
      "ownerSurface": "tablet_local",
      "storagePolicy": "local_cache",
      "tabletAccess": "read_write_when_operationally_required",
      "pcAuthority": "pc_governs_policy_and_history",
      "syncPolicy": "vertical.apparel.VariantMatrix.v0 events via outbox when changed locally",
      "auditImpact": "required_when_affects_money_inventory_customer_or_compliance",
      "offlineImpact": "must_declare_safe_local_behavior_before_tablet_release",
      "coreRelations": [
        "Product"
      ],
      "requiredEvents": [
        "vertical.apparel.VariantMatrix.created",
        "vertical.apparel.VariantMatrix.updated"
      ],
      "fixtures": [
        "apparel_VariantMatrix_happy_path.json",
        "apparel_VariantMatrix_edge_case.json"
      ],
      "acceptanceCriteria": [
        "extension validates without mutating core schema",
        "extension has at least one fixture",
        "extension declares Tablet and PC ownership",
        "extension can be disabled without breaking other verticals"
      ],
      "forbiddenCoreFields": [
        "lotExpiration",
        "tableNumber",
        "repairOrderId",
        "routeStopId"
      ]
    },
