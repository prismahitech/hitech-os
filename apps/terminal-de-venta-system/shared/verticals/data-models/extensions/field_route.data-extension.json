      "coreRelations": [
        "SaleLine"
      ],
      "requiredEvents": [
        "vertical.field_route.Route.created",
        "vertical.field_route.Route.updated"
      ],
      "fixtures": [
        "field_route_Route_happy_path.json",
        "field_route_Route_edge_case.json"
      ],
      "acceptanceCriteria": [
        "extension validates without mutating core schema",
        "extension has at least one fixture",
        "extension declares Tablet and PC ownership",
        "extension can be disabled without breaking other verticals"
      ],
      "forbiddenCoreFields": [
        "tableNumber",
