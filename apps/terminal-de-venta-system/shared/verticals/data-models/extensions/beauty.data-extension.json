{
  "verticalId": "beauty",
  "label": "Estetica / barberia / salon",
  "version": "0.3.0",
  "principle": "Vende servicios, citas y comisiones; inventario de producto existe pero no manda todo el negocio.",
  "extensions": [
    {
      "extensionId": "beauty.Service",
      "entityName": "Service",
      "extensionType": "workflow_extension",
      "ownerSurface": "tablet_local",
      "storagePolicy": "local_required",
      "tabletAccess": "read_write_when_operationally_required",
      "pcAuthority": "pc_governs_policy_and_history",
      "syncPolicy": "vertical.beauty.Service.v0 events via outbox when changed locally",
      "auditImpact": "required_when_affects_money_inventory_customer_or_compliance",
      "offlineImpact": "must_declare_safe_local_behavior_before_tablet_release",
      "coreRelations": [
        "SaleLine"
      ],
      "requiredEvents": [
        "vertical.beauty.Service.created",
        "vertical.beauty.Service.updated"
      ],
      "fixtures": [
        "beauty_Service_happy_path.json",
        "beauty_Service_edge_case.json"
      ],
      "acceptanceCriteria": [
        "extension validates without mutating core schema",
        "extension has at least one fixture",
        "extension declares Tablet and PC ownership",
        "extension can be disabled without breaking other verticals"
      ],
      "forbiddenCoreFields": [
        "lotExpiration",
        "tableNumber",
        "repairVin",
        "scaleWeight"
