{
  "ownershipModel": "prisma.verticals.entity-ownership.v0",
  "version": "0.3.0",
  "rules": [
    {
      "surface": "Tablet",
      "owns": "local operational write path for sales, payments, shifts, outbox and required vertical capture"
    },
    {
      "surface": "PC",
      "owns": "policy, advanced configuration, global reconciliation, analytics, long history and conflict resolution"
