  "auditRules": [
    {
      "ruleId": "field_route.audit.money_inventory",
      "when": "money_or_inventory_changes",
      "requiredFields": [
        "actorId",
        "terminalId",
        "businessId",
        "entityType",
        "entityId",
        "before",
        "after",
        "occurredAt"
      ]
    },
    {
      "ruleId": "field_route.audit.permission_sensitive",
      "when": "sensitive_permission_used",
      "requiredFields": [
        "actorId",
        "permission",
        "reason",
        "occurredAt"
      ]
    },
    {
      "ruleId": "field_route.audit.offline_sensitive",
      "when": "offline_sensitive_action",
      "requiredFields": [
        "actorId",
        "terminalId",
        "offlineReason",
        "occurredAt"
      ]
    }
  ],
  "syncRules": [
    {
      "topicPattern": "field_route.*",
      "offlineAllowed": true,
      "retry": "automatic",
      "humanStatus": "Pendiente por enviar"
    },
    {
      "topicPattern": "payment.*",
      "offlineAllowed": true,
      "retry": "manual_if_failed",
      "humanStatus": "Requiere revision si falla"
    },
    {
      "topicPattern": "return.*",
      "offlineAllowed": true,
      "retry": "manual_if_failed",
      "humanStatus": "Devolucion pendiente por enviar"
    }
  ]
}
