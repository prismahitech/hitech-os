      "core.inventory.basic",
      "customer.profile",
      "core.sync"
    ]
  },
  "surfaces": {
    "tablet": {
      "enabled": true,
      "routes": [
        "Ordenes",
        "Vender",
        "Clientes",
        "Refacciones",
        "Cobro",
        "Turno"
      ]
    },
    "pc": {
      "enabled": true,
      "routes": [
        "Dashboard",
        "Catalogo",
        "Inventario",
        "Auditoria",
        "Configuracion"
      ]
    }
  },
  "offline": {
    "salesAllowed": true,
    "sensitiveActionsRequireConnection": true
  }
}