{
  "name": "PRISMA App",
  "short_name": "PRISMA",
  "description": "Tu negocio al día, desde tu celular: consulta, pulso, alertas y reportes ligeros.",
  "id": "/prisma-app",
  "start_url": "/prisma-app",
  "scope": "/prisma-app",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#07080d",
  "theme_color": "#07080d",
  "categories": [
    "business",
    "productivity"
  ],
  "lang": "es-MX",
  "icons": [
    {
      "src": "/icons/prisma_playstore_icon_192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/prisma_playstore_icon_512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/prisma-app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/prisma-app-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/icons/prisma-app-monochrome.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "monochrome"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/prisma-mobile-pwa-dashboard.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "PRISMA App instalada como PWA"
    }
  ],
  "shortcuts": [
    {
      "name": "Hoy",
      "short_name": "Hoy",
      "description": "Resumen del negocio de hoy.",
      "url": "/prisma-app?section=hoy",
      "icons": [
        {
          "src": "/icons/prisma_playstore_icon_192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Alertas",
      "short_name": "Alertas",
      "description": "Alertas importantes del negocio.",
      "url": "/prisma-app?section=alertas",
      "icons": [
        {
          "src": "/icons/prisma_playstore_icon_192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Instalar",
      "short_name": "Instalar",
      "description": "Selector Android o iPhone para instalar PRISMA App.",
      "url": "/prisma-app/install",
      "icons": [
        {
          "src": "/icons/prisma_playstore_icon_192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/manifest.webmanifest",
      "id": "/prisma-app"
    }
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  }
}
