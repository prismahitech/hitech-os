{
  "contractId": "PRISMA_APP_MOBILE_09_PWA_DOMAIN_INSTALL_READY",
  "requiredPublicPaths": [
    "/prisma-app",
    "/prisma-app/install",
    "/manifest.webmanifest",
    "/prisma-mobile-sw.js",
    "/prisma-offline.html",
    "/prisma-mobile-pwa.config.json",
    "/.well-known/pwa-domain-check.json"
  ],
  "recommendedHeaders": [
    {
      "path": "/manifest.webmanifest",
      "header": "Content-Type",
      "value": "application/manifest+json"
    },
    {
      "path": "/prisma-mobile-sw.js",
      "header": "Service-Worker-Allowed",
      "value": "/"
    }
  ],
  "playStoreDeferred": true
}