      }
    },
    {
      "name": "catalogo vacio",
      "input": {
        "openShift": true,
        "pendingEvents": 0,
        "failedEvents": 0,
        "conflictEvents": 0,
        "activeProducts": 0,
        "lowStockProducts": 0
      },
      "expected": {
        "shift": "Turno abierto",
        "connection": "En linea",
        "catalog": "Catalogo vacio"
      }
    },
    {
      "name": "existencias bajas",
      "input": {
        "openShift": true,
        "pendingEvents": 0,
        "failedEvents": 0,
        "conflictEvents": 0,
        "activeProducts": 120,
        "lowStockProducts": 7
      },
      "expected": {
        "shift": "Turno abierto",
        "connection": "En linea",
