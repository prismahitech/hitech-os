  "cases": [
    {
      "id": "C01",
      "title": "catalog route uses selling assist mode catalog",
      "route": "/catalog",
      "expect": [
        "CatalogStockSellingAssistScreen",
        "mode=\"catalog\"",
        "Catálogo que sí vende"
      ]
    },
    {
      "id": "C02",
      "title": "stock route uses selling assist mode stock",
      "route": "/stock",
      "expect": [
        "CatalogStockSellingAssistScreen",
        "mode=\"stock\"",
        "Existencias para vender"
      ]
    },
    {
      "id": "C03",
      "title": "existencias route renders stock mode",
      "route": "/existencias",
      "expect": [
        "CatalogStockSellingAssistScreen",
        "mode=\"stock\""
      ]
    },
    {
      "id": "C04",
      "title": "available product can be added",
      "productId": "p_available",
      "expectedSignal": "available",
      "canAdd": true
    },
    {
      "id": "C05",
      "title": "low stock product can be added with warning",
      "productId": "p_low",
      "expectedSignal": "low_stock",
      "canAdd": true
    },
    {
      "id": "C06",
      "title": "out of stock product is blocked",
      "productId": "p_zero",
      "expectedSignal": "out_of_stock",
      "canAdd": false
    },
    {
      "id": "C07",
      "title": "inactive product is blocked",
      "productId": "p_inactive",
      "expectedSignal": "inactive",
      "canAdd": false
    },
    {
      "id": "C08",
      "title": "cart handoff uses existing POS storage key",
      "expect": [
        "POS_CART_STORAGE_KEY",
        "addProductToCart",
        "prisma:tablet-cart-updated"
      ]
    },
    {
      "id": "C09",
      "title": "screen exposes offline strip",
      "expect": [
        "navigator.onLine",
        "online",
        "offline",
        "Sin conexión visible"
      ]
    },
    {
      "id": "C10",
      "title": "filters expose stock states",
      "expect": [
        "available",
        "low_stock",
        "out_of_stock",
        "inactive"
      ]
    }
  ]
}