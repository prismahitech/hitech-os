{
  "name": "@hitech/keystone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev-next.mjs",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"providers/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"visual-tests/**/*.{ts,tsx}\" \"playwright.config.ts\" \"scripts/ui-improvement-runner.mjs\" \"scripts/scene-studio-runner.mjs\" \"scripts/scene-studio-report.mjs\" \"scripts/scene-studio-dev.mjs\" \"scripts/scene-proof-gate.mjs\" \"scripts/scene-proof-ci.mjs\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ui:improvement:test": "node ./scripts/ui-improvement-runner.mjs",
    "ui:improvement:test:update-baseline": "node ./scripts/ui-improvement-runner.mjs --update-baseline",
    "ui:layers:verify": "node ./scripts/ui-improvement-runner.mjs --server-mode=dev -- visual-tests/layer-system-validation.spec.ts",
    "keystone:scene:studio": "node ./scripts/scene-studio-dev.mjs",
    "keystone:scene:visual": "node ./scripts/scene-studio-runner.mjs --full --server-mode=prod",
    "keystone:scene:visual:smoke": "node ./scripts/scene-studio-runner.mjs --smoke --server-mode=dev",
    "keystone:scene:visual:update": "node ./scripts/scene-studio-runner.mjs --full --update-baseline --server-mode=dev",
    "keystone:scene:report": "node ./scripts/scene-studio-report.mjs",
    "keystone:scene:proof:gate": "node ./scripts/scene-proof-gate.mjs",
    "keystone:scene:proof:ci": "node ./scripts/scene-proof-ci.mjs"
  },
  "dependencies": {
    "@hitech/contracts": "workspace:*",
    "@hitech/ui-kit": "workspace:*",
    "@tanstack/react-query": "5.64.2",
    "next": "16.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.23.8",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@types/node": "22.13.9",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@types/react-test-renderer": "19.0.0",
    "autoprefixer": "10.4.20",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "postcss": "8.4.49",
    "react-test-renderer": "19.0.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.2",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20.0.0 <26.0.0",
    "pnpm": ">=9.0.0 <10.0.0"
  }
}
